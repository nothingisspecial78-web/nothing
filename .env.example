# ==============================================================================
# UNIVERSAL AI ASSISTANT - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and fill in your real API keys.
# ==============================================================================

PORT=3000
APP_URL="MY_APP_URL"
NODE_ENV=development
LOG_LEVEL=info

# --- AI Providers (Fallback Chain: OpenRouter -> Gemini -> Groq) ---
OPENROUTER_API_KEY=""
LLM_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL_FAST="openai/gpt-4o-mini"
OPENROUTER_MODEL_STRONG="openai/gpt-4o-mini"
OPENROUTER_MODEL_VISION="openai/gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL_FAST="gemini-2.0-flash"
GEMINI_MODEL_STRONG="gemini-2.0-pro"

GROQ_API_KEY=""
GROQ_MODEL_FAST="llama-3.3-70b-versatile"
GROQ_MODEL_STRONG="llama-3.3-70b-versatile"

LLM_TIMEOUT_MS=25000

# --- Security Secrets ---
JWT_SECRET="dev-jwt-secret-replace-with-secure-32-char-random-string"
CONFIRMATION_SECRET="dev-confirm-hmac-secret-replace-with-secure-32-char-random-string"

# --- Rate Limits & Cache ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_IP=120
RATE_LIMIT_MAX_USER=60
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=5000
RESPONSE_CACHE_TTL_MS=300000

# --- Vector Store / RAG (Optional) ---
VECTOR_STORE_MODE="auto"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Billing & Razorpay Payments (Optional) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_TEST_MODE=true
ALLOW_DEV_PLAN_SWITCH=true
