{
  "name": "ai-assistant-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node node_modules/vite/bin/vite.js build && node node_modules/vite/bin/vite.js build --config packages/widget/vite.config.ts && node -e \"import('node:fs').then(fs=>{fs.mkdirSync('dist/widget',{recursive:true});fs.copyFileSync('packages/widget/dist/assistant.js','dist/widget/assistant.js');})\"",
    "build:widget": "node node_modules/vite/bin/vite.js build --config packages/widget/vite.config.ts",
    "start": "node node_modules/tsx/dist/cli.mjs server.ts",
    "clean": "rm -rf dist packages/widget/dist",
    "lint": "tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "ingest": "node node_modules/tsx/dist/cli.mjs packages/server/src/cli/ingest.ts",
    "eval": "node node_modules/tsx/dist/cli.mjs packages/server/src/cli/eval.ts",
    "seed:assistant-test": "node node_modules/tsx/dist/cli.mjs packages/server/src/cli/seedAssistantTest.ts",
    "seed:chips-test": "node node_modules/tsx/dist/cli.mjs packages/server/src/cli/seedAssistantTest.ts",
    "seed:data-access-test": "node node_modules/tsx/dist/cli.mjs scripts/seedDataAccessTest.ts",
    "seed:multi-tenant-test": "node node_modules/tsx/dist/cli.mjs scripts/seedMultiTenantTest.ts",
    "avatar:inspect": "node node_modules/tsx/dist/cli.mjs scripts/inspectAvatar.ts",
    "guides:check": "node node_modules/tsx/dist/cli.mjs scripts/checkGuides.ts",
    "seed:guide-test": "node node_modules/tsx/dist/cli.mjs scripts/seedGuideTest.ts",
    "seed:qa": "node node_modules/tsx/dist/cli.mjs scripts/seedQa.ts",
    "perf:nav": "node node_modules/tsx/dist/cli.mjs scripts/perfNav.ts",
    "perf:scroll": "node node_modules/tsx/dist/cli.mjs scripts/perfScroll.ts",
    "perf:api": "node node_modules/tsx/dist/cli.mjs scripts/perfApi.ts",
    "perf:bundle": "node node_modules/tsx/dist/cli.mjs scripts/perfBundle.ts",
    "qa:assistant": "node node_modules/tsx/dist/cli.mjs scripts/qa/runAllAgents.ts",
    "qa:webapp": "node node_modules/tsx/dist/cli.mjs scripts/qa/webapp/runWebappQa.ts",
    "cli": "node node_modules/tsx/dist/cli.mjs scripts/cli.ts",
    "doctor": "node node_modules/tsx/dist/cli.mjs scripts/cli.ts doctor",
    "qa:all": "npm run perf:bundle && npm run perf:api && npm run perf:scroll && npm run perf:nav"
  },
  "exports": {
    "./core": "./packages/core/src/index.ts",
    "./widget": "./packages/widget/src/index.ts",
    "./react": "./packages/widget/src/index.ts",
    "./server": "./packages/server/src/index.ts"
  },

  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@google/genai": "^3.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-accordion": "^1.3.1",
